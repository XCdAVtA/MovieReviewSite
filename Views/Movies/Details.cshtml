@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h1>@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Genre)</dt>
    <dd class="col-sm-10">@Model.Genre</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Rating)</dt>
    <dd class="col-sm-10">@Model.Rating</dd>

    <dt class="col-sm-2">Runtime</dt>
    <dd class="col-sm-10">@Model.RuntimeHours h @Model.RuntimeMinutes m</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ReleaseDate)</dt>
    <dd class="col-sm-10">@Model.ReleaseDate.ToString("MMMM d, yyyy")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Synopsis)</dt>
    <dd class="col-sm-10">@Model.Synopsis</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>