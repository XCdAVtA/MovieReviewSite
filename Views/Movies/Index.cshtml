@model IEnumerable<MoviesAdmin.Models.Movie>

@{ ViewData["Title"] = "Movies"; }

<h1>Movies</h1>

@if (User.IsInRole("administrator"))
{
    <p><a asp-action="Create" class="btn btn-primary">Add New Movie</a></p>
}

<table class="table align-middle">
    <thead>
    <tr>
        <th></th>
        <th>@Html.DisplayNameFor(m => m.Title)</th>
        <th>@Html.DisplayNameFor(m => m.Genre)</th>
        <th>@Html.DisplayNameFor(m => m.Rating)</th>
        <th>Runtime</th>
        <th>@Html.DisplayNameFor(m => m.ReleaseDate)</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                {
                    <img src="@movie.PosterUrl" alt="@movie.Title poster" class="poster-thumb" />
                }
            </td>
            <td>@movie.Title</td>
            <td>@movie.Genre</td>
            <td>@movie.Rating</td>
            <td>@movie.RuntimeHours h @movie.RuntimeMinutes m</td>
            <td>@movie.ReleaseDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Details" asp-route-id="@movie.Id">View</a>
                @if (User.IsInRole("administrator"))
                {
                    <span> | </span><a asp-action="Edit" asp-route-id="@movie.Id">Edit</a>
                    <span> | </span><a asp-action="Delete" asp-route-id="@movie.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>