@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<h3 class="text-danger">Are you sure you want to delete this movie?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Genre)</dt>
    <dd class="col-sm-10">@Model.Genre</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ReleaseDate)</dt>
    <dd class="col-sm-10">@Model.ReleaseDate.ToString("MMMM d, yyyy")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>